# Copy to apps/helper/.env. Bun loads .env from the directory a script runs in, so a .env at the repo root is ignored.
FONT_SYNC_GOOGLE_CLIENT_ID=
FONT_SYNC_GOOGLE_CLIENT_SECRET=
