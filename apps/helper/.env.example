# Copy to apps/helper/.env. Bun loads .env from the directory a script runs in, so a .env at the repo root is ignored.
# For local development you can instead save the client once in config.json, which the CLI and start-at-login
# read from any directory. From apps/helper: bun src/main.ts setup --client-id ... --client-secret ... --no-autostart
# (without --no-autostart, start at login runs this repo copy, which holds port 47321 while you use dev).
# These values win over config.json while set. Never set them for a public build (FONT_SYNC_PUBLIC_BUILD=1 fails).
FONT_SYNC_GOOGLE_CLIENT_ID=
FONT_SYNC_GOOGLE_CLIENT_SECRET=
# FONT_SYNC_PORT=47321  (must match apps/plugin/manifest.json)
# FONT_SYNC_NO_BROWSER=1 (do not open browser tabs; for tests)
